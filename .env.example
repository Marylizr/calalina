# Supabase PostgreSQL connection strings for Prisma.
#
# DATABASE_URL should use the Supabase Transaction Pooler URI, usually port 6543.
# DIRECT_URL should use the Supabase Session Pooler URI, not Direct Connection.
# Both URLs must start with postgresql://
# Replace [YOUR-PASSWORD] with the real encoded Supabase database password.
# Do not use the Supabase Project URL, such as https://xxxxx.supabase.co, for Prisma.
# Avoid db.<project>.supabase.co direct host if your local network has IPv6 issues.
DATABASE_URL="postgresql://YOUR_SUPABASE_TRANSACTION_POOLER_URL"
DIRECT_URL="postgresql://YOUR_SUPABASE_SESSION_POOLER_URL"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Public fallback for WhatsApp click-to-chat links.
# Use international format without +, spaces or symbols.
NEXT_PUBLIC_SHOP_WHATSAPP_NUMBER="34600000000"

# Temporary native admin login used by /admin/login until Auth.js is wired.
ADMIN_EMAIL="admin@calalina.com"
ADMIN_PASSWORD="change-this-password"
ADMIN_SESSION_SECRET="generate-a-long-random-secret"

# Future Auth.js setup.
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional image storage.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Read-only Google Places API for public opening hours.
GOOGLE_MAPS_API_KEY=
